--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -28,6 +28,38 @@
 #include "ksu.h"
 #include "util.h"
 
+/* -- 4.19 compat: nofault family (kernel 4.20+/5.8+/5.9+) -- */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 20, 0)
+static inline long __must_check copy_from_user_nofault(void *to, const void __user *from, unsigned long n) {
+    if (!__range_ok(from, n)) return -EFAULT;
+    pagefault_disable();
+    n = __copy_from_user_inatomic(to, from, n);
+    pagefault_enable();
+    return n;
+}
+static inline long __must_check copy_to_user_nofault(void __user *to, const void *from, unsigned long n) {
+    if (!__range_ok(to, n)) return -EFAULT;
+    pagefault_disable();
+    n = __copy_to_user_inatomic(to, from, n);
+    pagefault_enable();
+    return n;
+}
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+/* probe_kernel_write was renamed to copy_to_kernel_nofault in 5.8 */
+#define copy_to_kernel_nofault(dst, src, size) probe_kernel_write(dst, src, size)
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+static inline long strncpy_from_user_nofault(char *dst, const void __user *unsafe_addr, long count) {
+    long ret;
+    pagefault_disable();
+    ret = strncpy_from_user(dst, unsafe_addr, count);
+    pagefault_enable();
+    return ret >= count ? count : ret;
+}
+#endif
+
+
 #define SU_PATH "/system/bin/su"
 #define SH_PATH "/system/bin/sh"
 

