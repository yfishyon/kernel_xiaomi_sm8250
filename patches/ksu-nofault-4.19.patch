--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -18,6 +18,17 @@
 #include <linux/sched/task_stack.h>
 #include <linux/ptrace.h>
 
+/* 4.19 compat: nofault family (4.20+/5.9+) */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+static inline long strncpy_from_user_nofault(char *dst, const void __user *unsafe_addr, long count) {
+    long ret;
+    pagefault_disable();
+    ret = strncpy_from_user(dst, unsafe_addr, count);
+    pagefault_enable();
+    return ret >= count ? count : ret;
+}
+#endif
+
 #include "arch.h"
 #include "klog.h" // IWYU pragma: keep
 #include "ksu.h"
--- a/kernel/hook/arm64/patch_memory.c
+++ b/kernel/hook/arm64/patch_memory.c
@@ -23,6 +23,13 @@
 #include <asm/memory.h>
 #include <asm/barrier.h>
 
+/* 4.19 compat: copy_to_kernel_nofault was probe_kernel_write before 5.8 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+#ifndef copy_to_kernel_nofault
+#define copy_to_kernel_nofault(dst, src, size) probe_kernel_write(dst, src, size)
+#endif
+#endif
+
 #include "klog.h" // IWYU pragma: keep
 #include "hook/arm64/patch_memory.h"
 
